# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# MongoDB connection string.
# Local MongoDB:   mongodb://127.0.0.1:27017/smart_warehouse_db
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster-url>/smart_warehouse_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/smart_warehouse_db

# Any long, random string. Used to sign JWT auth tokens.
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=8h

# Port the Express server listens on.
PORT=5000

# Allowed origin(s) for CORS - your Vite dev server.
CLIENT_ORIGIN=http://localhost:5173

# Set to "true" to auto-insert demo data on startup if the database is empty.
SEED_ON_START=true
